{
  "name": "unified-attestation",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "npm run -w @ua/backend dev",
    "dev:portal": "npm run -w @ua/portal dev",
    "build": "npm run -w @ua/common build && npm run -w @ua/backend build && npm run -w @ua/portal build",
    "lint": "npm run -w @ua/backend lint && npm run -w @ua/portal lint",
    "test": "npm run -w @ua/backend test"
  },
  "dependencies": {
    "@ua/portal": "^0.1.0",
    "esbuild": "^0.27.2",
    "lucide-react": "^1.27.0"
  }
}
