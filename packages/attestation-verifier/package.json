  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/unifiedattestation/Backend.git",
    "directory": "packages/attestation-verifier"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jose": "^5.9.3",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
